include README.md AI_USAGE.md VERIFICATION.md requirements-cpu.txt requirements-local-lock.txt app.py
recursive-include petseg *.py
recursive-include configs *.json
recursive-include tests *.py
recursive-include docs *.md
recursive-include notebooks *.ipynb
recursive-include scripts *.py
include .streamlit/config.toml
include .gitattributes .gitignore
global-exclude *.pyc
prune data
prune artifacts
prune .venv
prune .verify-venv
prune .uv-cache
